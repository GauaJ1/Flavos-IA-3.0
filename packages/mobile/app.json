{
  "expo": {
    "name": "Flavos IA",
    "slug": "flavos-ia",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/Flavos_3.png",
    "splash": {
      "image": "./assets/Flavos_3.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "flavosia",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flavos.ia"
    },
    "android": {
      "package": "com.flavos.ia",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "aaca40b9-5564-4894-9f9b-82d6b6567d55"
      }
    }
  }
}
