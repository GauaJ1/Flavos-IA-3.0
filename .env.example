# ===================================================
# Flavos IA 3.0 — Environment Variables
# ===================================================
# Copie este arquivo para .env e preencha os valores.

# ──────────────────────────────────────────────────
# ✅ OBRIGATÓRIO — Chat & Autenticação
# ──────────────────────────────────────────────────

# Google Gemini API Key (chave do AI Studio / Google Cloud)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo do Gemini
GEMINI_MODEL=gemini-2.5-flash

# Porta do backend proxy
PORT=3001

# URL do backend acessível pelo frontend
# Em produção: URL pública da VPS (com HTTPS se configurado)
# Ex: http://159.112.180.28:3001 ou https://api.seudominio.com
VITE_API_URL=http://localhost:3001

# Firebase — Web SDK (usado pelo middleware de auth do backend)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase — Admin (apenas para o backend)
FIREBASE_PROJECT_ID=your_project_id

# ──────────────────────────────────────────────────
# ⚙️  OPCIONAL — Lixeira Automática (Cron Job)
# Necessário apenas se for usar o /api/admin/cleanup-trash
# Gere a chave de serviço em:
# Firebase Console → Configurações → Contas de Serviço
# ──────────────────────────────────────────────────

# CLEANUP_SECRET=gere_com_node_-e_crypto.randomBytes(32).toString('hex')
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@seu_projeto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
