# flavos-ia-3.0/.env (TEMPLATE DE PRODUÇÃO)
# COPIE ESTE CONTEÚDO PARA O ARQUIVO .env NA SUA VPS E PREENCHA OS VALORES.

# --- GEMINI ---
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.0-flash-exp

# --- API URL ---
# Use a sua URL do DuckDNS com HTTPS
VITE_API_URL=https://flavosia-api.duckdns.org
PORT=3001

# --- FIREBASE ADMIN (Para a Lixeira Automática) ---
# Baixe o JSON no Console do Firebase em 'Contas de Serviço'.
FIREBASE_PROJECT_ID=flavos-ia-3
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@flavos-ia-3.iam.gserviceaccount.com
# Use aspas duplas e preserve os \n na private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --- SEGURANÇA DO CRON JOB ---
# Invente uma senha forte aqui (ex: use um gerador de senhas)
# Esta mesma senha deve ir no cron-job.org como 'Bearer [senha]'
CLEANUP_SECRET=invente_uma_senha_muito_longa_aqui
